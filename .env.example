# CleanCPU environment configuration
# Copy this file to .env and adjust values for your deployment.
# None of these variables are required in local mode — the defaults work out of the box.

# ---------------------------------------------------------------------------
# Deployment environment
#   local       Default. Waitress binds 127.0.0.1. No proxy headers trusted.
#   staging     Behind Apache/nginx/ALB. Proxy headers trusted. HTTP cookies.
#   production  Behind HTTPS reverse proxy/ALB. Proxy headers trusted. Secure cookies.
# ---------------------------------------------------------------------------
CLEANCPU_ENV=local

# ---------------------------------------------------------------------------
# Network binding (Waitress / Flask)
#   127.0.0.1   Loopback only (default, safest for desktop use)
#   0.0.0.0     All interfaces (required behind AWS ALB / Docker)
# ---------------------------------------------------------------------------
CLEANCPU_HOST=127.0.0.1
CLEANCPU_PORT=5000

# ---------------------------------------------------------------------------
# Allowed Host headers (DNS-rebinding protection)
# Comma-separated list of hostnames/IPs that are accepted in the Host header.
# Wildcards supported: *.example.com
# These are ADDED to the built-in list (127.0.0.1, localhost, *.radec.com.mx, …).
# Leave blank if the built-in list is sufficient.
# ---------------------------------------------------------------------------
CLEANCPU_ALLOWED_HOSTS=

# Example (Apache/WampServer LAN deployment):
# CLEANCPU_ALLOWED_HOSTS=192.168.1.100,myserver.local

# Example (AWS with custom domain):
# CLEANCPU_ALLOWED_HOSTS=cleancpu.example.com,*.example.com

# ---------------------------------------------------------------------------
# Reverse-proxy trust
#   0 / false   Disabled (default for local)
#   1 / true    Trust X-Forwarded-For and X-Forwarded-Proto headers
#               (automatically enabled when CLEANCPU_ENV=staging or production)
# ---------------------------------------------------------------------------
CLEANCPU_TRUST_PROXY=false

# Number of trusted reverse-proxy hops (Apache/nginx = 1, double-proxy = 2)
CLEANCPU_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# Flask secret key
# Used to sign session cookies. In production set this to a long random value
# and keep it secret. If unset, an ephemeral key is generated at startup
# (sessions reset on restart — fine for local desktop use).
# ---------------------------------------------------------------------------
# FLASK_SECRET_KEY=replace-with-a-long-random-string-in-production

# ===========================================================================
# RADEC Server — Enrolamiento del agente
# ===========================================================================
# Estas TRES variables son las que hacen que el equipo aparezca en el tablero
# de Mantenimiento. Sin ellas el agente arranca, funciona como herramienta
# local, y NO reporta nada: lo dice en el log al arrancar.
#
# DÓNDE SE PONEN
# --------------
# El agente las busca, en este orden:
#   1. Variables de entorno del proceso   (para GPO / despliegue masivo)
#   2. Este archivo, renombrado a `.env`, junto al ejecutable
#   3. %PROGRAMDATA%\CleanCPU\agente.env  (lo escribe el instalador)
#
# Lo normal es NO editar esto a mano: usa el instalador del servidor,
#   scripts\Instalar-Agente-Mantenimiento.ps1
# que además valida el token contra el servidor antes de dar el alta por buena
# y registra la tarea programada que arranca el agente con el equipo.
#
# NOTA HISTÓRICA: hasta agosto de 2026 este bloque no servía de nada. No había
# ningún cargador de `.env` (no hay python-dotenv ni load_dotenv en el agente),
# y además el worker que mantiene vivo el equipo leía otros nombres
# (RADEC_MANTENIMIENTO_*), sin documentar, con `http://127.0.0.1:8110` por
# omisión. Ahora los dos caminos pasan por services/agent_config.py, que lee
# este archivo y acepta los dos juegos de nombres.
# ---------------------------------------------------------------------------

# URL del servidor RADEC. Preferir el dominio (pasa por Apache con TLS).
# CLEANCPU_SERVER_URL=https://sistemas.radec.com.mx

# Token Bearer. Debe coincidir EXACTAMENTE con RADEC_MANTENIMIENTO_AGENT_TOKEN
# del servidor. Si el servidor no lo tiene configurado responde 503 a todos los
# agentes; si no coincide, 403. El agente lo dice con esas palabras en el log.
# CLEANCPU_AGENT_TOKEN=

# Sucursal del equipo (columna del tablero). Por omisión SIN_ASIGNAR.
# CLEANCPU_SUCURSAL=CLJ

# Segundos entre ciclos de reporte. Por omisión 300; se acota a 30..3600.
# Con cientos de equipos, bajar de 60 satura el servidor sin aportar nada.
# CLEANCPU_SYNC_INTERVAL=300

# Alias heredados, aceptados para no romper equipos ya configurados:
#   RADEC_MANTENIMIENTO_SERVER       -> CLEANCPU_SERVER_URL
#   RADEC_MANTENIMIENTO_AGENT_TOKEN  -> CLEANCPU_AGENT_TOKEN
#   RADEC_SUCURSAL                   -> CLEANCPU_SUCURSAL
